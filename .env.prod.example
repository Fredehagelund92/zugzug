# Zugzug — production environment. Copy to `.env` (same directory as compose.prod.yml),
# fill in, then: docker compose -f compose.prod.yml up -d --build
# See docs/deploy.md. NEVER commit your real .env.

# ---- Deploy (required) ----
# Public domain (must have a DNS A/AAAA record pointing at this host) and an
# email for Let's Encrypt expiry notices.
DOMAIN=zugzug.example.com
ACME_EMAIL=ops@example.com

# Public URL of the app. MUST be https://<DOMAIN> — this is what makes session
# cookies Secure and builds correct OAuth redirects.
ORIGIN=https://zugzug.example.com

# ---- Database (required) ----
# Password for the bundled Postgres. Must be URL-safe because compose builds
# DATABASE_URL as postgres://zugzug:<password>@postgres:5432/zugzug — special
# characters like /, +, = (produced by base64) break the connection-string parser.
# Generate a URL-safe password (hex: 0-9a-f only):
#   openssl rand -hex 32
# If you supply your own DATABASE_URL (external Postgres, see below) you can use
# any password as long as you percent-encode it in the URL yourself.
POSTGRES_PASSWORD=

# To use an EXTERNAL/managed Postgres instead of the bundled one, set DATABASE_URL
# here (and remove the `postgres` service from compose.prod.yml). Leave commented
# to use the bundled DB (compose builds DATABASE_URL from POSTGRES_PASSWORD).
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# ---- Secrets (generate; back these up) ----
# HMAC key for Pull-API pagination cursors:  openssl rand -base64 32
ZUGZUG_CURSOR_KEY=

# Webhooks (optional). If you enable them, set a master key and BACK IT UP —
# losing it makes every stored webhook signing secret unrecoverable.
WEBHOOKS_ENABLED=0
# ZUGZUG_WEBHOOK_MASTER_KEY=   # openssl rand -base64 32

# ---- Demo seed (optional) ----
# true loads a full fictional demo dataset on first boot (reference tables,
# typed columns, a hierarchy, and value-mapping). Leave false for a real install.
SEED_DEMO=false

# ---- Warehouse (optional) ----
# Off by default: record + publish works Postgres-only. To scan a warehouse and
# (optionally) publish dim_/map_ into it, enable and provide a token.
ATTACH_WAREHOUSE=false
WAREHOUSE_ADAPTER=motherduck
MOTHERDUCK_TOKEN=
# Demo alternative: a bundled LOCAL DuckDB warehouse (no token, no cloud). Set
# ATTACH_WAREHOUSE=true, WAREHOUSE_ADAPTER=duckdb, and a path on the /data volume.
# With SEED_DEMO=true it's generated on first boot with sample messy data.
# With SEED_DEMO=false, if this path doesn't already exist the server refuses
# to start rather than silently creating an empty warehouse.
DUCK_WAREHOUSE_PATH=
# WRITABLE mode publishes dim_/map_ INTO your warehouse. This is the least-tested
# path in the repo — validate against a staging warehouse before trusting prod dbt.
MOTHERDUCK_WRITABLE=false
ZUGZUG_DB=zugzug

# ---- Auth (optional: OIDC / SSO) ----
# Leave OIDC_ISSUER_URL unset for local email+password (first signup = admin).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAIN=
# Restrict signups to an email domain in BOTH password and OIDC modes:
ALLOWED_DOMAIN=

# ---- Tuning (optional) ----
PG_POOL_MAX=5
ZUGZUG_PULL_API_RPM=600
ZUGZUG_AUTH_RPM=10
# Per-workspace budget for paid AI suggestion calls.
ZUGZUG_AI_RPM=60
# Per-IP throttle on the same endpoints, applied by nginx (the app only sees a
# proxy address, so it cannot do this itself). nginx rate syntax.
AUTH_RATE_LIMIT=60r/m
# IMPORTANT if anything fronts this stack (a cloud edge, a load balancer): set
# it to that proxy's range, or every visitor shares one throttle bucket and a
# single attacker can lock out all sign-ins at once.
TRUSTED_PROXY_CIDR=127.0.0.1

# ---- Observability (optional) ----
# Opt-in server error tracking. Set to your Sentry DSN to capture unexpected
# 500s, crashes, and failed scans. Unset = disabled (no telemetry).
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production   # optional; defaults to "production"
