# Zug Zug backend — the three stores from ARCHITECTURE.md.
# Copy to `server/.env` and fill in. Bun auto-loads .env from the cwd.

# App state (OLTP): Postgres — drafts, audit, users, presence. Read/write.
# Any Postgres works (Supabase, Neon, RDS, local). Example shapes:
#   postgres://user:pass@host:5432/dbname
#   postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# Which warehouse adapter to load (only when ATTACH_WAREHOUSE=true).
# Supported: motherduck. snowflake is a stub and will fail to boot.
WAREHOUSE_ADAPTER=motherduck

# MotherDuck token — gives one connection both the warehouse (read-only scan)
# and the Zug Zug canonical database (read/write dim_/map_). Get it at
# https://app.motherduck.com → Settings → Access Tokens.
MOTHERDUCK_TOKEN=

# The MotherDuck database that holds your existing warehouse source tables
# (scanned read-only). Defaults to `analytics`. If your account is empty, run
# `bun run bootstrap -- --seed` to provision a demo warehouse here.
WAREHOUSE_DB=analytics

# Attach the MotherDuck warehouse (enables the discovery scan). Off by default —
# Postgres-only canonical/draft/commit works without it. Flip to true once the
# warehouse is wired (needs the motherduck extension + outbound network).
ATTACH_WAREHOUSE=false

# The MotherDuck database Zug Zug owns and writes (dim_/map_). Created if absent.
ZUGZUG_DB=zugzug

# Local DuckDB engine file (the "home" db that ATTACHes the two remotes).
# ":memory:" is fine — all durable state lives in Postgres + MotherDuck.
DUCK_PATH=:memory:

PORT=8787

# === Authentication ===
#
# Two modes (one-or-the-other per deployment):
#
# 1) PASSWORD MODE (default when OIDC_ISSUER_URL is unset):
#    Local email + password. First user to sign up becomes the admin and
#    is added to the allowlist. Subsequent users must be invited by an
#    admin in Settings → Team.
#
# 2) OIDC MODE (when OIDC_ISSUER_URL is set):
#    Single-sign-on via any OpenID Connect provider (Google Workspace,
#    Okta, Authentik, Keycloak, etc.). The "Sign in with SSO" button
#    appears on the login page.
#
# Set the OIDC_* env vars below to enable OIDC mode. Example for Google:
#   OIDC_ISSUER_URL=https://accounts.google.com
#   OIDC_CLIENT_ID=...your.google.client.id...
#   OIDC_CLIENT_SECRET=...your.google.client.secret...
#   OIDC_ALLOWED_DOMAIN=example.com    (optional; restricts signups)
#   OIDC_LABEL=Google                  (optional; shown on the SSO button)

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAIN=
OIDC_LABEL=

# Legacy: ALLOWED_DOMAIN. Restricts signups in BOTH password and OIDC modes.
# Falls back to OIDC_ALLOWED_DOMAIN if unset.
ALLOWED_DOMAIN=

# Deprecated: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
# These were used by the Google-OAuth-only path that's been replaced by
# generic OIDC. If you previously used Google OAuth, migrate by setting:
#   OIDC_ISSUER_URL=https://accounts.google.com
#   OIDC_CLIENT_ID=<your existing GOOGLE_CLIENT_ID>
#   OIDC_CLIENT_SECRET=<your existing GOOGLE_CLIENT_SECRET>
# The GOOGLE_* vars are no longer read.

# Public base URL of this app. Used to build the OAuth redirect_uri.
# Dev: http://localhost:5173   Prod: https://yourapp.com
ORIGIN=http://localhost:5173

# Dev-only auth bypass — shows a "Dev mode" login button that skips auth.
# NEVER set this in production.
DEV_BYPASS_AUTH=false

# === AI Mapping Suggestions (optional; MVP requires manual API key configuration) ===
#
# If you want to enable AI-powered mapping suggestions, set one of the providers below.
# See docs/superpowers/DECISIONS.md for architecture decisions, cost estimates, and strategy.
#
# MVP Provider (default): OpenAI
#   Get a key at https://platform.openai.com/account/api-keys
#   Model used: gpt-4o-mini
OPENAI_API_KEY=

# Phase 2 Provider: Anthropic (supported but not active in MVP)
#   Get a key at https://console.anthropic.com
#   Model: claude-opus-4-1 (or later)
ANTHROPIC_API_KEY=

# Postgres pool sizing — defaults to 5 for the main pool.
# Migrations run with their own max=1 connection.
PG_POOL_MAX=5

# MotherDuck-writable mode — flip to "true" only if your MotherDuck token has
# write access. When true, commits write dim_*/map_* records to your MotherDuck
# database (canonical destination = warehouse). When false (default), canonical
# lives in Postgres and snapshots are downloadable on demand.
MOTHERDUCK_WRITABLE=false

# Engineer-mode default — when "false", hides warehouse internals (table names,
# SQL, MERGE/JOIN copy) for non-technical analysts. Each user can override this
# in Settings. Default: true (engineer details shown).
DEFAULT_ENGINEER_MODE=true

# ---------- Outbound integrations (PR1+ — defaults safe for OSS) ----------

# Enable the webhook dispatcher (PR3). Hosted SaaS sets this to 1;
# OSS users opt in. Webhooks UI + API still render in an inert state
# when this is off — no 404s.
WEBHOOKS_ENABLED=0

# AES-256-GCM master key for encrypting webhook signing secrets at rest.
# Provide either the key itself (base64 of 32 random bytes) or a path to
# a file containing it (chmod 600). On self-host with ZUGZUG_SELF_HOSTED=1
# and WEBHOOKS_ENABLED=1, if neither is set, the server auto-generates a
# key at <DATA_DIR>/webhook-master.key on first boot — BACK IT UP, losing
# it makes every existing webhook secret unrecoverable.
# ZUGZUG_WEBHOOK_MASTER_KEY=
# ZUGZUG_WEBHOOK_MASTER_KEY_FILE=/etc/zugzug/webhook-master.key

# HMAC key for signing Pull API pagination cursors (PR2). 32 random bytes,
# base64. Rotating invalidates all in-flight cursors (clients resync from
# ?since=, which is benign for a read API).
# ZUGZUG_CURSOR_KEY=

# Self-host mode. Relaxes the http://localhost webhook ban and enables
# auto-generation of the webhook master key on first boot.
ZUGZUG_SELF_HOSTED=1
